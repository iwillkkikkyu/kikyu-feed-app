{
  "manifest_version": 3,
  "name": "끼뀨 피드 보내기",
  "version": "1.1.1",
  "description": "트위터(X) 트윗마다 발바닥 버튼을 달아, 메모와 함께 끼뀨 피드로 보낸다.",
  "icons": { "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "끼뀨 피드 설정", "default_icon": { "48": "icon-48.png" } },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
